<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="05-alter-lessons-drop-video-url" author="thanghub">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="lessons" columnName="video_url"/>
        </preConditions>
        <dropColumn tableName="lessons" columnName="video_url"/>
    </changeSet>

    <changeSet id="05-alter-lessons-add-video-file-id" author="thanghub">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="lessons" columnName="video_file_id"/>
            </not>
        </preConditions>

        <addColumn tableName="lessons">
            <column name="video_file_id" type="UUID"/>
        </addColumn>

        <addForeignKeyConstraint
                baseTableName="lessons"
                baseColumnNames="video_file_id"
                referencedTableName="video_files"
                referencedColumnNames="id"
                constraintName="fk_lessons_video_file"/>
    </changeSet>

</databaseChangeLog>
