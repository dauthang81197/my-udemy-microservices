# Database — auth-service
DB_URL=jdbc:postgresql://<host>:5432/my-udemy-auth
DB_USERNAME=postgres
DB_PASSWORD=

# Database — course-service
DB_URL_COURSE=jdbc:postgresql://<host>:5432/my-udemy-course

# Redis
REDIS_HOST=localhost
